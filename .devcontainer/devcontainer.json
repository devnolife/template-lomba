// ============================================================================
// devcontainer.json — GitHub Codespaces untuk development
// ============================================================================
// Menjalankan MongoDB + dev environment di dalam Codespaces.
// Backend (server/) dan Dashboard (client/) jalan via npm scripts.
// ============================================================================
{
  "name": "Contest Monitor Dev",

  // ── Docker Compose untuk MongoDB + dev container ──────────────────────────
  "dockerComposeFile": "../dashboard-contest/docker-compose.dev.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspace",

  // ── Features ──────────────────────────────────────────────────────────────
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "configureZshAsDefaultShell": false,
      "installOhMyZsh": false,
      "upgradePackages": false
    }
  },

  // ── VS Code Extensions & Settings ─────────────────────────────────────────
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "eamodio.gitlens"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  // ── Environment ───────────────────────────────────────────────────────────
  "containerEnv": {
    "NODE_ENV": "development"
  },

  // ── Port Forwarding ───────────────────────────────────────────────────────
  "forwardPorts": [3000, 5173, 27017],
  "portsAttributes": {
    "3000": {
      "label": "Backend API",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Dashboard (Vite)",
      "onAutoForward": "openBrowser"
    },
    "27017": {
      "label": "MongoDB",
      "onAutoForward": "silent"
    }
  },

  // ── Lifecycle ─────────────────────────────────────────────────────────────
  "postCreateCommand": "cd /workspace/dashboard-contest && npm install && npm run install:all",
  "postStartCommand": "echo '\\n✅ Contest Monitor ready!\\n   cd dashboard-contest && npm run dev\\n   Backend:   http://localhost:3000\\n   Dashboard: http://localhost:5173\\n'",

  "remoteUser": "node"
}
